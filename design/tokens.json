{
  "_note": "DTCG-style. Code uses ONLY color.semantic.* (not the primitives). Dark via $extensions.modes.dark. Origin: enum BringTheme in Widget/BringWidgetView.swift (the app's fixed dark widget palette). Light neutrals (paper/ink/inkMuted) are conservatively derived, not taken from the app.",
  "color": {
    "primitive": {
      "coral":       { "$type": "color", "$value": "#E26056" },
      "coralBorder": { "$type": "color", "$value": "#C54D44" },
      "mint":        { "$type": "color", "$value": "#5BA399" },
      "navy":        { "$type": "color", "$value": "#2C3F50" },
      "navyRaised":  { "$type": "color", "$value": "#354A5D" },
      "white":       { "$type": "color", "$value": "#FFFFFF" },
      "mist":        { "$type": "color", "$value": "#AEB8C2" },
      "paperRaised": { "$type": "color", "$value": "#F1F4F7" },
      "ink":         { "$type": "color", "$value": "#1F2933" },
      "inkMuted":    { "$type": "color", "$value": "#52606D" }
    },
    "semantic": {
      "bg": {
        "$type": "color", "$value": "{color.primitive.white}",
        "$extensions": { "modes": { "dark": "{color.primitive.navy}" } }
      },
      "fg": {
        "$type": "color", "$value": "{color.primitive.ink}",
        "$extensions": { "modes": { "dark": "{color.primitive.white}" } }
      },
      "muted": {
        "$type": "color", "$value": "{color.primitive.inkMuted}",
        "$extensions": { "modes": { "dark": "{color.primitive.mist}" } }
      },
      "accent": {
        "$type": "color", "$value": "{color.primitive.coral}",
        "$extensions": { "modes": { "dark": "{color.primitive.coral}" } }
      },
      "accentBorder": {
        "$type": "color", "$value": "{color.primitive.coralBorder}",
        "$extensions": { "modes": { "dark": "{color.primitive.coralBorder}" } }
      },
      "surfaceRaised": {
        "$type": "color", "$value": "{color.primitive.paperRaised}",
        "$extensions": { "modes": { "dark": "{color.primitive.navyRaised}" } }
      },
      "success": {
        "$type": "color", "$value": "{color.primitive.mint}",
        "$extensions": { "modes": { "dark": "{color.primitive.mint}" } }
      },
      "onAccent": {
        "$type": "color", "$value": "{color.primitive.white}",
        "$extensions": { "modes": { "dark": "{color.primitive.white}" } }
      },
      "widgetSurface": {
        "$type": "color", "$value": "{color.primitive.navy}",
        "$extensions": { "modes": { "dark": "{color.primitive.navy}" } }
      },
      "widgetSurfaceRaised": {
        "$type": "color", "$value": "{color.primitive.navyRaised}",
        "$extensions": { "modes": { "dark": "{color.primitive.navyRaised}" } }
      }
    }
  },
  "space": {
    "xs": { "$type": "dimension", "$value": "4px" },
    "sm": { "$type": "dimension", "$value": "6px" },
    "md": { "$type": "dimension", "$value": "12px" },
    "lg": { "$type": "dimension", "$value": "24px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "8px" },
    "md": { "$type": "dimension", "$value": "12px" },
    "lg": { "$type": "dimension", "$value": "16px" }
  },
  "icon": {
    "sm": { "$type": "dimension", "$value": "16px" },
    "md": { "$type": "dimension", "$value": "20px" },
    "lg": { "$type": "dimension", "$value": "24px" }
  }
}
