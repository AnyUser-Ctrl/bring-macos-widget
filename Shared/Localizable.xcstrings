    "Email": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "E-Mail"
          }
        }
      }
    },
    "Email and password are stored in plain text in the App Group container so the app and the widget can sign in again automatically when tokens expire. Intended for personal use on your own Mac only.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "E-Mail und Passwort werden im Klartext im App-Group-Container abgelegt, damit sich die App und das Widget bei abgelaufenen Tokens automatisch neu anmelden können. Nur für den privaten Gebrauch auf deinem eigenen Mac gedacht."
          }
        }
      }
    },
    "Fetches the selected Bring! list directly from api.getbring.com and re-renders the widget.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Holt die ausgewählte Bring!-Liste direkt von api.getbring.com und aktualisiert das Widget."
